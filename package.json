{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor for Jungle Gaming Challenge",
  "author": "Pedro Vinicius",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "bun test --path-ignore-patterns \"dist/**\"",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:e2e": "bun test --path-ignore-patterns \"dist/**\" test/e2e",
    "test:concurrency": "bun test --path-ignore-patterns \"dist/**\" test/concurrency",
    "test:homologation": "bun test --path-ignore-patterns \"dist/**\" test/homologation",
    "test:homologation:containers": "docker compose up -d --wait postgres localstack && bun run migration:up && bun run test:homologation",
    "test:all": "bun test --path-ignore-patterns \"dist/**\" test/unit test/integration test/e2e test/concurrency && bun run test:homologation",
    "test:operational": "bun run build && bun test --path-ignore-patterns \"dist/**\" test/operational",
    "migration:up": "bun run src/infrastructure/database/run-migrations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.758.0",
    "@mikro-orm/core": "^6.4.8",
    "@mikro-orm/migrations": "^6.4.8",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.8",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/terminus": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.8",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.2.4",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  }
}
